<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F0F2F5" xmlns:android="http://schemas.android.com/apk/res/android"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FeyzTCP Tester" android:textSize="22sp" android:textStyle="bold" android:textColor="#1A1A1A" android:layout_marginBottom="12dp" /><!-- IP & Port --><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><EditText android:id="@+id/etIp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:hint="Server IP" android:text="192.168.4.1" android:inputType="textUri|number" /><EditText android:id="@+id/etPort" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Port" android:text="8080" android:inputType="number" /></LinearLayout><!-- Connect / Disconnect Button --><Button android:id="@+id/btnConnect" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:backgroundTint="#28A745" android:text="Connect" android:textColor="#FFFFFF" android:textStyle="bold" /><!-- Speed Test Action Buttons --><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp"><Button android:id="@+id/btnSpeedTestESP" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:backgroundTint="#17A2B8" android:textSize="12sp" android:text="Speed: ESP Wi-Fi" android:textColor="#FFFFFF" /><Button android:id="@+id/btnSpeedTestSTM" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="4dp" android:backgroundTint="#6F42C1" android:textSize="12sp" android:text="Speed: STM32 Link" android:textColor="#FFFFFF" /></LinearLayout><!-- Custom Hex Input --><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp" android:gravity="center_vertical"><EditText android:id="@+id/etCustomHex" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="Hex Byte (00 - FF)" android:maxLength="2" android:inputType="textCapCharacters" /><Button android:id="@+id/btnSendCustom" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Send" android:layout_marginStart="8dp" /></LinearLayout><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Custom Keys (Tap: Send | Long-Press: Rename &amp; Byte)" android:textSize="11sp" android:textColor="#555555" android:layout_marginTop="12dp" android:layout_marginBottom="6dp" /><!-- Action Buttons 1 & 2 --><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><Button android:id="@+id/btnKey1" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="KEY1 (0x01)" /><Button android:id="@+id/btnKey2" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="KEY2 (0x02)" /></LinearLayout><!-- Action Buttons 3 & 4 --><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp"><Button android:id="@+id/btnKey3" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="KEY3 (0x03)" /><Button android:id="@+id/btnKey4" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="KEY4 (0x04)" /></LinearLayout><!-- Log Actions: Copy, Share & Clear --><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp"><Button android:id="@+id/btnCopyLog" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="3dp" android:backgroundTint="#6C757D" android:textSize="11sp" android:text="Copy" /><Button android:id="@+id/btnShareLog" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:backgroundTint="#007BFF" android:textSize="11sp" android:text="Share" /><Button android:id="@+id/btnClearLog" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginStart="3dp" android:backgroundTint="#DC3545" android:textSize="11sp" android:text="Clear" /></LinearLayout><!-- Enlarged Auto-scrolling, Selectable Log View --><ScrollView android:id="@+id/scrollLog" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="6dp" android:background="#1E1E1E" android:padding="8dp" android:nestedScrollingEnabled="true"><TextView android:id="@+id/tvLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#00FF66" android:fontFamily="monospace" android:textSize="12sp" android:textIsSelectable="true" android:text="Ready.\n" /></ScrollView></LinearLayout></ScrollView>